# /etc/k1f-tg.env — secrets and runtime settings for the k1f-tg service.
# Permissions MUST be 0600 and owned by root: this file holds API tokens.

# Telegram bot token from @BotFather.
TELOXIDE_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Your personal Telegram account id (a signed integer). Messages sent to the
# bot are forwarded here. Find it via @userinfobot.
MASTER_TG_ID=123456789

# OpenAI API key (for the /gpt command). Optional if you don't use /gpt, but
# the bot will .expect() on first use, so set it to keep the service healthy.
GPT_TOKEN=sk-...

# Chat model to use with /gpt. Optional; defaults to "gpt-5.5".
# Note: gpt-4.1 was retired by OpenAI on 2026-02-13 and now returns an error.
GPT_MODEL=gpt-5.5

# Log level for pretty_env_logger. Optional; defaults to "info" in the unit.
RUST_LOG=info

# Path to the SQLite database. Optional; defaults to "k1f.sqlite" in the
# working directory (set to /var/lib/k1f/k1f.sqlite under systemd).
K1F_DB_PATH=/var/lib/k1f/k1f.sqlite
