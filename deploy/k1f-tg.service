# k1f-tg — Telegram "swiss-knife" bot.
#
# Install:
#   sudo install -m 644 deploy/k1f-tg.service /etc/systemd/system/k1f-tg.service
#   sudo install -m 600 /path/to/k1f-tg.env /etc/k1f-tg.env   # see k1f-tg.env.example
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now k1f-tg
#
# Note: the bot spawns /bin/ping for the /ping command. /bin/ping usually gets
# its privileges via file capabilities, so NoNewPrivileges= is deliberately left
# at the default (false) — setting it would break /ping.

[Unit]
Description=k1f-tg Telegram bot
Documentation=https://github.com/builat/k1f
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- User / paths -----------------------------------------------------------
User=k1f
Group=k1f
WorkingDirectory=/var/lib/k1f

EnvironmentFile=/etc/k1f-tg.env

# Default log level; can be overridden in the env file.
Environment=RUST_LOG=info

ExecStart=/usr/local/bin/k1f-tg

Restart=on-failure
RestartSec=5s

# Send both stdout and stderr to the journal, tagged for `journalctl -u k1f-tg`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=k1f-tg

# --- Hardening --------------------------------------------------------------
# Most restrictions are safe. The /ping command works because /bin/ping gets
# CAP_NET_RAW from the bounding set + AmbientCapabilities below: when the bot
# exec()s /bin/ping, that capability survives into the child whether /bin/ping
# is a file-capability binary or a plain setuid one.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/k1f
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictNamespaces=true

# Outbound-only network access for a bot.
IPAddressDeny=link-local multicast
RestrictRealtime=true

# CAP_NET_RAW is what /bin/ping needs to send ICMP. Without it (or with an
# empty bounding set) execve("/bin/ping") fails with EPERM, breaking /ping.
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
